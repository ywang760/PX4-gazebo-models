<?xml version="1.0"?>
<model>
  <name>Aerial Manipulator tilted hex</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>LeCAR Lab</name>
    <email>lecar-lab@cmu.edu</email>
  </author>
  <description>
    SITL model of the fixed 30-degree tilted hexarotor aerial manipulator.
    Geometry and motor order are compatibility locked; inertia and rotor
    coefficients are documented simulation surrogates.
  </description>
</model>
