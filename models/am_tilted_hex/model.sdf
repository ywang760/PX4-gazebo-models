<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="am_tilted_hex">
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- Gazebo body axes are FLU. PX4 airframe vectors are converted from FRD
         with [x, y, z]_FLU = [x, -y, -z]_FRD. -->
    <link name="base_link">
      <pose>0 0 0.32 0 0 0</pose>
      <inertial>
        <mass>7.018</mass>
        <inertia>
          <!-- Planar six-point-ring surrogate, pending system identification. -->
          <ixx>0.476385</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.476385</iyy>
          <iyz>0</iyz>
          <izz>0.952770</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box><size>0.40 0.30 0.12</size></box>
        </geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box><size>0.40 0.30 0.12</size></box>
        </geometry>
        <material><diffuse>0.12 0.12 0.14 1</diffuse></material>
      </visual>

      <!-- Primitive-only arms keep this reference model independent of CAD. -->
      <visual name="arm_0_visual">
        <pose>0 -0.18415 0 0 1.570796 -1.570796</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3683</length></cylinder></geometry>
        <material><diffuse>0.20 0.20 0.23 1</diffuse></material>
      </visual>
      <visual name="arm_1_visual">
        <pose>0 0.18415 0 0 1.570796 1.570796</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3683</length></cylinder></geometry>
        <material><diffuse>0.20 0.20 0.23 1</diffuse></material>
      </visual>
      <visual name="arm_2_visual">
        <pose>0.1594785 0.092075 0 0 1.570796 0.523599</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3683</length></cylinder></geometry>
        <material><diffuse>0.20 0.20 0.23 1</diffuse></material>
      </visual>
      <visual name="arm_3_visual">
        <pose>-0.1594785 -0.092075 0 0 1.570796 -2.617994</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3683</length></cylinder></geometry>
        <material><diffuse>0.20 0.20 0.23 1</diffuse></material>
      </visual>
      <visual name="arm_4_visual">
        <pose>0.1594785 -0.092075 0 0 1.570796 -0.523599</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3683</length></cylinder></geometry>
        <material><diffuse>0.20 0.20 0.23 1</diffuse></material>
      </visual>
      <visual name="arm_5_visual">
        <pose>-0.1594785 0.092075 0 0 1.570796 2.617994</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.3683</length></cylinder></geometry>
        <material><diffuse>0.20 0.20 0.23 1</diffuse></material>
      </visual>

      <collision name="left_skid_collision">
        <pose>0 0.18 -0.275 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.45</length></cylinder></geometry>
        <surface><contact><ode/></contact><friction><ode/></friction></surface>
      </collision>
      <visual name="left_skid_visual">
        <pose>0 0.18 -0.275 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.45</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>
      <collision name="right_skid_collision">
        <pose>0 -0.18 -0.275 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.45</length></cylinder></geometry>
        <surface><contact><ode/></contact><friction><ode/></friction></surface>
      </collision>
      <visual name="right_skid_visual">
        <pose>0 -0.18 -0.275 0 1.570796 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.45</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.17 1</diffuse></material>
      </visual>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></pressure></air_pressure>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.00018665</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.00018665</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.00018665</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.00186</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.00186</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.00186</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- Match the PX4 Harmonic reference sensor until measured AM noise is available. -->
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- Rotor link poses rotate local +Z onto the converted FLU thrust axis. -->
    <link name="rotor_0">
      <pose>0 -0.3683 0.32 0 0.523599 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000116</ixx><iyy>0.0000116</iyy><izz>0.0000232</izz></inertia></inertial>
      <visual name="rotor_0_visual"><geometry><cylinder><radius>0.1524</radius><length>0.008</length></cylinder></geometry><material><diffuse>0.95 0.38 0.12 0.7</diffuse></material></visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent><child>rotor_0</child>
      <axis><xyz expressed_in="__model__">0.5 0 0.866025</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_1">
      <pose>0 0.3683 0.32 0 0.523599 0</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000116</ixx><iyy>0.0000116</iyy><izz>0.0000232</izz></inertia></inertial>
      <visual name="rotor_1_visual"><geometry><cylinder><radius>0.1524</radius><length>0.008</length></cylinder></geometry><material><diffuse>0.12 0.45 0.95 0.7</diffuse></material></visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent><child>rotor_1</child>
      <axis><xyz expressed_in="__model__">0.5 0 0.866025</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_2">
      <pose>0.318957 0.18415 0.32 0 0.523599 2.094395</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000116</ixx><iyy>0.0000116</iyy><izz>0.0000232</izz></inertia></inertial>
      <visual name="rotor_2_visual"><geometry><cylinder><radius>0.1524</radius><length>0.008</length></cylinder></geometry><material><diffuse>0.95 0.38 0.12 0.7</diffuse></material></visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent><child>rotor_2</child>
      <axis><xyz expressed_in="__model__">-0.25 0.4330125 0.866025</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_3">
      <pose>-0.318957 -0.18415 0.32 0 0.523599 2.094395</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000116</ixx><iyy>0.0000116</iyy><izz>0.0000232</izz></inertia></inertial>
      <visual name="rotor_3_visual"><geometry><cylinder><radius>0.1524</radius><length>0.008</length></cylinder></geometry><material><diffuse>0.12 0.45 0.95 0.7</diffuse></material></visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent><child>rotor_3</child>
      <axis><xyz expressed_in="__model__">-0.25 0.4330125 0.866025</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_4">
      <pose>0.318957 -0.18415 0.32 0 0.523599 -2.094395</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000116</ixx><iyy>0.0000116</iyy><izz>0.0000232</izz></inertia></inertial>
      <visual name="rotor_4_visual"><geometry><cylinder><radius>0.1524</radius><length>0.008</length></cylinder></geometry><material><diffuse>0.12 0.45 0.95 0.7</diffuse></material></visual>
    </link>
    <joint name="rotor_4_joint" type="revolute">
      <parent>base_link</parent><child>rotor_4</child>
      <axis><xyz expressed_in="__model__">-0.25 -0.4330125 0.866025</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <link name="rotor_5">
      <pose>-0.318957 0.18415 0.32 0 0.523599 -2.094395</pose>
      <inertial><mass>0.001</mass><inertia><ixx>0.0000116</ixx><iyy>0.0000116</iyy><izz>0.0000232</izz></inertia></inertial>
      <visual name="rotor_5_visual"><geometry><cylinder><radius>0.1524</radius><length>0.008</length></cylinder></geometry><material><diffuse>0.95 0.38 0.12 0.7</diffuse></material></visual>
    </link>
    <joint name="rotor_5_joint" type="revolute">
      <parent>base_link</parent><child>rotor_5</child>
      <axis><xyz expressed_in="__model__">-0.25 -0.4330125 0.866025</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- 26.5127 N / (1500 rad/s)^2. This is a simulation authority surrogate. -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName><turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>1.178341e-05</motorConstant><momentConstant>0.05</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName><turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>1.178341e-05</motorConstant><momentConstant>0.05</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName><turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>1.178341e-05</motorConstant><momentConstant>0.05</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName><turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>1.178341e-05</motorConstant><momentConstant>0.05</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_4_joint</jointName><linkName>rotor_4</linkName><turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>1.178341e-05</motorConstant><momentConstant>0.05</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>4</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_5_joint</jointName><linkName>rotor_5</linkName><turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>1.178341e-05</motorConstant><momentConstant>0.05</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>5</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient><rollingMomentCoefficient>1e-06</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="MotorFailurePlugin" name="gz::sim::systems::MotorFailureSystem"/>
  </model>
</sdf>
